        <mxCell id="rules-20260925-0" value="身份与入库｜当前有效档案与历史身份分开&lt;br&gt;部件编号／制造编号可在删除后复用，新旧身份及历史独立；M番号不复用。&lt;br&gt;已删除衣体不计入有效成员；空有效批次不展示，历史登记仍保留。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;fontSize=22;align=left;verticalAlign=middle;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="10" y="980" width="1220" height="170" as="geometry" />
        </mxCell>
        <mxCell id="rules-20260925-1" value="关系与实物｜历史始终属于原对象&lt;br&gt;删除产品／部件不清除原绑定、更正和操作历史。&lt;br&gt;正常换衣体只记“更换衣体”，不新建衣体、不变更绑定。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;fontSize=22;align=left;verticalAlign=middle;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="1290" y="980" width="1220" height="170" as="geometry" />
        </mxCell>
        <mxCell id="rules-20260925-2" value="发货文件｜SHIPMENT_DOCUMENT_VERSION 包含保障确认书&lt;br&gt;保障确认书仅含生成时本笔发货产品；每次生成独立版本，不覆盖。&lt;br&gt;准备可连同全部所属文件／邮件删除；正式寄出后禁止删除。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;fontSize=22;align=left;verticalAlign=middle;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="2570" y="980" width="1220" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>