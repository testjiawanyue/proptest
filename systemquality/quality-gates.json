{
  "version": "1.0",
  "project": "PROP",
  "description": "AI 开发项目质量保证门禁定义。初始模式均为影子或告警，达到稳定标准后转为阻断。",
  "principles": [
    "需求基准独立于实现",
    "确定性工具优先",
    "AI 不担任最终裁判",
    "风险决定验证深度",
    "证据必须绑定提交号、环境、工具版本和执行时间",
    "任何新增阻断门禁必须支持降级和人工替代"
  ],
  "riskLevels": {
    "P0": {
      "description": "不可逆业务动作、权限边界、核心数据一致性、正式文件产物或跨模块主链",
      "minimumLayers": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ],
      "humanApproval": true
    },
    "P1": {
      "description": "重要业务流程、批量操作、历史数据、统计口径或时间边界",
      "minimumLayers": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4"
      ],
      "humanApproval": true
    },
    "P2": {
      "description": "普通 CRUD、展示、文案、导航或非关键排序",
      "minimumLayers": [
        "L0",
        "L1",
        "L4-lite"
      ],
      "humanApproval": false
    },
    "P3": {
      "description": "纯文档、注释或对运行无影响的配置说明",
      "minimumLayers": [
        "L0-lite"
      ],
      "humanApproval": false
    }
  },
