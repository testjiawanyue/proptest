=== prop_reception_batch
CREATE TABLE `prop_reception_batch` (
  `batch_id` bigint(20) NOT NULL,
  `number_year` smallint(6) NOT NULL,
  `batch_seq` int(11) NOT NULL,
  `batch_no` varchar(24) NOT NULL,
  `received_at` datetime NOT NULL,
  `company_name` varchar(200) DEFAULT NULL,
  `recipient_name` varchar(200) DEFAULT NULL,
  `postal_text` varchar(64) DEFAULT NULL,
  `postal_search` char(7) DEFAULT NULL,
  `address` varchar(500) DEFAULT NULL,
  `address_extra` varchar(500) DEFAULT NULL,
  `contact_name` varchar(200) DEFAULT NULL,
  `phone` varchar(64) DEFAULT NULL,
  `note` text,
  `first_product_id` bigint(20) DEFAULT NULL,
  `source_order_id` bigint(20) DEFAULT NULL,
  `source_order_no` varchar(64) DEFAULT NULL,
  `create_by` varchar(64) NOT NULL,
  `create_time` datetime NOT NULL,
  `update_by` varchar(64) DEFAULT NULL,
  `update_time` datetime DEFAULT NULL,
  PRIMARY KEY (`batch_id`),
  UNIQUE KEY `uq_reception_batch_sequence` (`number_year`,`batch_seq`),
  UNIQUE KEY `uq_reception_batch_number` (`batch_no`),
  KEY `ix_reception_batch_date` (`received_at`,`batch_id`),
  KEY `ix_reception_batch_postal` (`postal_search`),
  KEY `fk_reception_first_product` (`first_product_id`),
  CONSTRAINT `fk_reception_first_product` FOREIGN KEY (`first_product_id`) REFERENCES `prop_product` (`product_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4
=== prop_reception_package
CREATE TABLE `prop_reception_package` (
  `package_id` bigint(20) NOT NULL,
  `batch_id` bigint(20) NOT NULL,
  `package_no` int(11) NOT NULL,
  `note` text,
  `create_by` varchar(64) NOT NULL,
  `create_time` datetime NOT NULL,
  `update_by` varchar(64) DEFAULT NULL,
  `update_time` datetime DEFAULT NULL,
  PRIMARY KEY (`package_id`),
  UNIQUE KEY `uq_reception_package_number` (`batch_id`,`package_no`),
  UNIQUE KEY `uq_reception_package_parent` (`package_id`,`batch_id`),
  CONSTRAINT `fk_reception_package_batch` FOREIGN KEY (`batch_id`) REFERENCES `prop_reception_batch` (`batch_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4
=== prop_reception
CREATE TABLE `prop_reception` (
  `reception_id` bigint(20) NOT NULL,
  `batch_id` bigint(20) NOT NULL,
  `package_id` bigint(20) NOT NULL,
  `product_id` bigint(20) NOT NULL,
  `number_year` smallint(6) NOT NULL,
  `small_seq` bigint(20) NOT NULL,
  `established_at` datetime NOT NULL,
  `notice_visible_ceiling` bigint(20) NOT NULL,
  `inspection_year` tinyint(4) DEFAULT NULL,
  `confirmation` varchar(8) DEFAULT NULL,
  `plan` varchar(16) DEFAULT NULL,
  `plan_manual` tinyint(1) NOT NULL DEFAULT '0',
  `box_count` int(11) DEFAULT NULL,
  `create_by` varchar(64) NOT NULL,
  `update_by` varchar(64) DEFAULT NULL,
  `update_time` datetime DEFAULT NULL,
  `work_state` varchar(16) NOT NULL DEFAULT 'in_progress',
  `work_group_mask` tinyint(3) unsigned NOT NULL DEFAULT '0',
  `work_basis_json` json NOT NULL,
  `first_completion_json` json DEFAULT NULL,
  `report_start_json` json DEFAULT NULL,
  PRIMARY KEY (`reception_id`),
  UNIQUE KEY `uq_reception_small` (`number_year`,`small_seq`),
  UNIQUE KEY `uq_reception_year` (`product_id`,`inspection_year`),
  KEY `ix_reception_product_order` (`product_id`,`established_at`,`reception_id`),
  KEY `ix_reception_batch_package` (`batch_id`,`package_id`,`small_seq`),
  KEY `fk_reception_package` (`package_id`,`batch_id`),
  KEY `ix_reception_work_order` (`batch_id`,`small_seq`,`reception_id`),
  CONSTRAINT `fk_reception_package` FOREIGN KEY (`package_id`, `batch_id`) REFERENCES `prop_reception_package` (`package_id`, `batch_id`),
  CONSTRAINT `fk_reception_product` FOREIGN KEY (`product_id`) REFERENCES `prop_product` (`product_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4
=== prop_product
CREATE TABLE `prop_product` (
  `product_id` bigint(20) NOT NULL AUTO_INCREMENT,
  `manufacturing_no` varchar(64) NOT NULL COMMENT '制造编号，历史原值永久保留',
  `active_manufacturing_no` varchar(64) DEFAULT NULL COMMENT '当前有效制造编号，删除时置空',
  `m_no` char(7) NOT NULL COMMENT '不可复用M番号：M+6位',
  `storage_path` varchar(500) DEFAULT NULL,
  `deleted_time` datetime DEFAULT NULL,
  `deleted_by` varchar(64) DEFAULT NULL,
  `create_by` varchar(64) DEFAULT '',
  `create_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `update_by` varchar(64) DEFAULT '',
  `update_time` datetime DEFAULT NULL,
  `remark` varchar(500) DEFAULT NULL,
  `first_shipment_date` date DEFAULT NULL,
  `lifecycle_base_month` char(7) DEFAULT NULL,
  `baseline_shipment_id` bigint(20) DEFAULT NULL,
  `external_product_name` varchar(200) DEFAULT NULL,
  `name_adopted_shipment_id` bigint(20) DEFAULT NULL,
  `scrapped_time` datetime DEFAULT NULL COMMENT '未来报废模块资格事实；本迁移不回填，不新增报废入口',
  `initial_production_inspection_passed` tinyint(1) NOT NULL DEFAULT '0' COMMENT 'Initial production inspection qualification: 0=not passed, 1=passed',
  PRIMARY KEY (`product_id`),
  UNIQUE KEY `uk_product_m_no` (`m_no`),
  UNIQUE KEY `uk_product_active_manufacturing_no` (`active_manufacturing_no`),
  KEY `idx_product_manufacturing_history` (`manufacturing_no`),
  KEY `idx_product_first_shipment` (`first_shipment_date`),
  KEY `idx_product_baseline_shipment` (`baseline_shipment_id`),
  KEY `fk_product_name_shipment` (`name_adopted_shipment_id`),
  KEY `idx_product_lifecycle_month` (`lifecycle_base_month`,`deleted_time`,`scrapped_time`),
  CONSTRAINT `fk_product_baseline_shipment` FOREIGN KEY (`baseline_shipment_id`) REFERENCES `prop_shipment` (`shipment_id`),
  CONSTRAINT `fk_product_name_shipment` FOREIGN KEY (`name_adopted_shipment_id`) REFERENCES `prop_shipment` (`shipment_id`)
) ENGINE=InnoDB AUTO_INCREMENT=868 DEFAULT CHARSET=utf8mb4 COMMENT='产品永久身份'
=== prop_part_item
CREATE TABLE `prop_part_item` (
  `part_id` bigint(20) NOT NULL AUTO_INCREMENT,
  `part_no` varchar(64) NOT NULL COMMENT '部件编号，历史原值永久保留',
  `active_part_no` varchar(64) DEFAULT NULL COMMENT '全类型当前有效编号，删除时置空',
  `part_type` varchar(16) NOT NULL COMMENT 'jacket/airbag/sensor/inflator',
  `source_type` varchar(16) NOT NULL COMMENT 'intake/assembly',
  `current_profile_id` bigint(20) NOT NULL,
  `current_profile_version_id` bigint(20) NOT NULL,
  `current_firmware_id` bigint(20) DEFAULT NULL,
  `deleted_time` datetime DEFAULT NULL,
  `deleted_by` varchar(64) DEFAULT NULL,
  `create_by` varchar(64) DEFAULT '',
  `create_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `update_by` varchar(64) DEFAULT '',
  `update_time` datetime DEFAULT NULL,
  `remark` varchar(500) DEFAULT NULL,
  PRIMARY KEY (`part_id`),
  UNIQUE KEY `uk_part_active_no` (`active_part_no`),
  KEY `idx_part_no_history` (`part_no`),
  KEY `idx_part_type_active` (`part_type`,`deleted_time`),
  KEY `idx_part_profile` (`current_profile_version_id`),
  KEY `fk_part_profile` (`current_profile_id`),
  KEY `fk_part_firmware` (`current_firmware_id`),
  CONSTRAINT `fk_part_firmware` FOREIGN KEY (`current_firmware_id`) REFERENCES `prop_base_data` (`data_id`),
  CONSTRAINT `fk_part_profile` FOREIGN KEY (`current_profile_id`) REFERENCES `prop_part_profile` (`profile_id`),
  CONSTRAINT `fk_part_profile_version` FOREIGN KEY (`current_profile_version_id`) REFERENCES `prop_part_profile_version` (`version_id`)
) ENGINE=InnoDB AUTO_INCREMENT=1300 DEFAULT CHARSET=utf8mb4 COMMENT='部件个体永久身份'
=== prop_product_binding
CREATE TABLE `prop_product_binding` (
  `binding_id` bigint(20) NOT NULL AUTO_INCREMENT,
  `product_id` bigint(20) NOT NULL,
  `part_id` bigint(20) NOT NULL,
  `slot_type` varchar(16) NOT NULL COMMENT 'body/airbag/sensor/inflator_1/inflator_2',
  `active_slot_key` varchar(96) DEFAULT NULL COMMENT '当前产品槽位唯一键',
  `active_part_key` bigint(20) DEFAULT NULL COMMENT '当前部件唯一键',
  `started_by` varchar(64) DEFAULT '',
  `started_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `ended_by` varchar(64) DEFAULT NULL,
  `ended_time` datetime DEFAULT NULL,
  PRIMARY KEY (`binding_id`),
  UNIQUE KEY `uk_binding_active_slot` (`active_slot_key`),
  UNIQUE KEY `uk_binding_active_part` (`active_part_key`),
  KEY `idx_binding_product_history` (`product_id`,`started_time`),
  KEY `idx_binding_part_history` (`part_id`,`started_time`),
  CONSTRAINT `fk_binding_part` FOREIGN KEY (`part_id`) REFERENCES `prop_part_item` (`part_id`),
  CONSTRAINT `fk_binding_product` FOREIGN KEY (`product_id`) REFERENCES `prop_product` (`product_id`)
) ENGINE=InnoDB AUTO_INCREMENT=1297 DEFAULT CHARSET=utf8mb4 COMMENT='产品部件绑定期间'
=== prop_production_event
CREATE TABLE `prop_production_event` (
  `event_id` bigint(20) NOT NULL AUTO_INCREMENT,
  `event_type` varchar(32) NOT NULL,
  `product_id` bigint(20) DEFAULT NULL,
  `part_id` bigint(20) DEFAULT NULL,
  `related_part_id` bigint(20) DEFAULT NULL,
  `binding_id` bigint(20) DEFAULT NULL,
  `before_profile_version_id` bigint(20) DEFAULT NULL,
  `after_profile_version_id` bigint(20) DEFAULT NULL,
  `before_firmware_id` bigint(20) DEFAULT NULL,
  `after_firmware_id` bigint(20) DEFAULT NULL,
  `event_content` varchar(500) NOT NULL,
  `create_by` varchar(64) DEFAULT '',
  `create_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `work_request_id` char(36) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,
  `disposition_reception_id` bigint(20) DEFAULT NULL COMMENT '实际报废拆除事件所属受付',
  PRIMARY KEY (`event_id`),
  KEY `idx_event_product` (`product_id`,`create_time`),
  KEY `idx_event_part` (`part_id`,`create_time`),
  KEY `idx_event_related_part` (`related_part_id`,`create_time`),
  KEY `ix_production_work_request` (`work_request_id`,`event_id`),
  KEY `ix_production_disposition` (`disposition_reception_id`,`event_id`),
  CONSTRAINT `fk_event_part` FOREIGN KEY (`part_id`) REFERENCES `prop_part_item` (`part_id`),
  CONSTRAINT `fk_event_product` FOREIGN KEY (`product_id`) REFERENCES `prop_product` (`product_id`),
  CONSTRAINT `fk_event_related_part` FOREIGN KEY (`related_part_id`) REFERENCES `prop_part_item` (`part_id`),
  CONSTRAINT `fk_production_disposition` FOREIGN KEY (`disposition_reception_id`) REFERENCES `prop_work_disposition` (`reception_id`),
  CONSTRAINT `fk_production_work_request` FOREIGN KEY (`work_request_id`) REFERENCES `prop_work_product_action` (`request_id`)
) ENGINE=InnoDB AUTO_INCREMENT=989 DEFAULT CHARSET=utf8mb4 COMMENT='生产规范事实事件'
