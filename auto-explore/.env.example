# ---- 应用环境（必填，必须是独立测试环境）----
APP_BASE_URL=http://localhost:80
APP_API_PREFIX=/prod-api
APP_LOGIN_USER=admin
APP_LOGIN_PASSWORD=
# 环境指纹：页面或接口中必须出现的标识，防止误连真实环境
APP_ENV_FINGERPRINT=

# ---- 测试库（必填，数据探针）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ry-vue-prop-test

# ---- 运行控制 ----
HEADLESS=true
MAX_STEPS_PER_CHARTER=40
TRACE_DIR=reports/traces
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
